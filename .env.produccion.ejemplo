# Copiar a `.env` EN EL SERVIDOR y rellenar. Nunca subir este archivo con
# valores reales a un repositorio.

# Dominio donde vivirá el panel. Su DNS debe apuntar ya al VPS: Caddy pide el
# certificado al arrancar y falla si el dominio no resuelve.
DOMINIO=panel.agenciaryf.com

# Contraseña de Postgres. Genera una larga y no la reutilices:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Firma las sesiones. Si cambia, todo el mundo queda desconectado.
#   openssl rand -base64 32
AUTH_SECRET=

# Cifra los secretos de los clientes.
#
# AVISO: si esta clave se pierde o cambia, los secretos guardados dejan de
# poder descifrarse y hay que reconectar TODOS los clientes desde cero.
# Guárdala también fuera del servidor, en un gestor de contraseñas.
#   openssl rand -hex 32
APPSEO_CLAVE_CIFRADO=

# Clave de la API de Anthropic, de console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional. Por defecto claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
