# Copia este archivo a .env.local y pon tu clave real de Anthropic.
# Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Respaldo: úsalo con el MISMO valor si tu sistema ya define ANTHROPIC_API_KEY
# (en algunos entornos viene vacía y dotenv no la sobrescribe).
APP_ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar (opcional). Por defecto: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6
