// Esquema del panel AppSEO.
//
// En producción corre sobre Postgres. Para volver a SQLite en local basta con
// cambiar `provider`, pero las migraciones no son intercambiables entre ambos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Persona que entra al panel.
model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  nombre       String
  clave        String // hash bcrypt, nunca la contraseña
  rol          Rol       @default(EDITOR)
  activo       Boolean   @default(true)
  creado       DateTime  @default(now())
  ultimoAcceso DateTime?

  accesos  Acceso[]
  registro Registro[]
}

enum Rol {
  ADMIN // todo, incluida la gestión de usuarios
  GESTOR // toda la cartera y todas las operaciones, salvo gestionar usuarios
  EDITOR // trabaja sobre los clientes que tenga asignados
  LECTOR // solo consulta
}

/// Sitio WordPress conectado mediante el plugin AppSEO RyF.
model Cliente {
  id      String @id @default(cuid())
  nombre  String
  dominio String @unique

  /// «wordpress» o «shopify». Decide con qué adaptador se habla con el sitio;
  /// todo lo demás del panel —posiciones, arquitectura, bitácora, gasto— es
  /// igual para los dos.
  plataforma String @default("wordpress")

  /// El dominio interno de Shopify, «algo.myshopify.com». El público va en
  /// «dominio», que es el que ve Google y con el que se cotejan las URLs.
  tienda String?

  urlRest String @default("")
  keyId   String @default("")

  /// Secreto HMAC cifrado con AES-256-GCM. Nunca se guarda en claro.
  secreto String

  activo Boolean  @default(true)
  creado DateTime @default(now())

  // Última foto conocida, para no consultar el sitio en cada carga.
  version     String?
  soloLectura Boolean?
  ultimaSonda DateTime?
  estadoSonda String?

  /// Función en pruebas: no todos los proyectos la necesitan, así que se
  /// activa cliente a cliente en vez de aparecerle a todo el mundo.
  betaArquitectura Boolean @default(false)

  /// Lo que el asistente debe saber siempre de este cliente —tono, qué no
  /// tocar, productos estrella— sin que haya que repetirlo cada día.
  instrucciones String?

  /// Lo que se le cobra al mes, en dólares. Sin esto el panel dice cuánto
  /// cuesta un cliente pero no si sale rentable.
  tarifa Float?

  /// Candado del panel, aparte del interruptor del plugin: vale para Shopify,
  /// donde no hay plugin, y para frenar sin tocar el sitio del cliente.
  escrituraBloqueada Boolean @default(false)

  /// Cada cuántos días se miden solas las posiciones. Nulo: solo a mano. Lo
  /// activa una persona en la ficha, viendo lo que cuesta cada pasada.
  medirCada Int?

  /// Propiedad de Search Console que corresponde a este sitio. Puede ser de
  /// tipo dominio («sc-domain:ejemplo.cl») o de prefijo de URL.
  gscPropiedad String?

  /// Con qué cuenta de Google se leen sus datos. Varias fichas pueden
  /// compartir una: quien gestiona diez sitios suele tenerlos todos bajo la
  /// misma cuenta y no debería autorizar diez veces.
  gscConexionId String?
  gscConexion   ConexionGoogle? @relation(fields: [gscConexionId], references: [id], onDelete: SetNull)

  accesos       Acceso[]
  registro      Registro[]
  trabajos      Trabajo[]
  arquitecturas Arquitectura[]
  keywords      Keyword[]
  memorias      Memoria[]
  gastos        Gasto[]
  bitacoras     Bitacora[]
  backlinks     Backlinks?
  revisiones    Revision[]
  rastreos      Rastreo[]
}

/// Una pasada del rastreador sobre un sitio.
///
/// Se guarda como tanda y no como columnas sueltas en el cliente porque lo que
/// se quiere responder casi siempre es «¿esto estaba roto la semana pasada?».
/// Con una sola foto no hay forma de saber si algo empeoró o si lleva así
/// desde siempre.
model Rastreo {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  /// «corriendo», «terminado», «error» o «interrumpido».
  ///
  /// «interrumpido» existe porque el rastreo vive en memoria del proceso: si el
  /// contenedor se reinicia a mitad, nadie va a marcar la tanda como acabada y
  /// sin este estado se quedaría en «corriendo» para siempre.
  estado String @default("corriendo")

  /// Cuántas URLs traía el sitemap y cuántas se llegaron a pedir.
  total   Int @default(0)
  hechas  Int @default(0)

  nota String?

  /// Lo que se comprueba una vez por sitio y no página por página: el
  /// robots.txt, sobre todo. En JSON porque son cuatro datos sueltos que no
  /// merecen cuatro columnas.
  sitio String?

  creado   DateTime  @default(now())
  tocado   DateTime  @updatedAt
  acabado  DateTime?

  paginas Pagina[]

  @@index([clienteId, creado])
}

/// Una auditoría de la ficha de Google Business de un negocio.
///
/// Se guardan todas y no solo la última porque el valor está en la comparación:
/// «tenías 58 y ahora tienes 74» es un informe; «tienes 74» es un dato suelto.
model AuditoriaFicha {
  id        String @id @default(cuid())
  clienteId String

  negocio String
  cid     String?

  /// De 0 a 100, calculada por el código con reglas fijas.
  nota Int

  /// Los cuatro bloques con sus puntos, y los hallazgos, en JSON.
  bloques   String
  hallazgos String

  /// Lo que escribió el modelo: resumen, arreglos rápidos y puntos fuertes.
  informe String?

  /// La ficha tal como vino, por si hace falta revisar de dónde salió una nota.
  datos String

  coste  Float @default(0)
  creado DateTime @default(now())

  @@index([clienteId, creado])
}

/// Un barrido de posiciones locales sobre una cuadrícula geográfica.
///
/// Mide algo que ninguna otra pantalla del panel mide: en SEO local no existe
/// «la posición». Un negocio puede salir primero para quien busca desde su
/// misma calle y no aparecer para quien busca a tres kilómetros. La cuadrícula
/// es la única forma de ver esa realidad, y también la única forma de
/// enseñarle a un cliente por qué su vecino sí lo encuentra y él no.
model Rejilla {
  id        String @id @default(cuid())
  clienteId String

  /// Qué se busca y qué ficha se busca dentro de los resultados.
  keyword String
  negocio String

  /// El identificador que Google le da a la ficha. Se compara por esto y no
  /// por el nombre: dos locales de la misma cadena tienen el mismo nombre, y
  /// un nombre puede escribirse de cinco maneras.
  cid String?

  centroLat Float
  centroLng Float

  /// Puntos por lado —siempre impar, para que haya centro— y kilómetros entre
  /// uno y otro.
  lado       Int   @default(9)
  separacion Float @default(1)

  /// «corriendo», «terminado», «error» o «interrumpido».
  estado String @default("corriendo")
  total  Int    @default(0)
  hechos Int    @default(0)

  coste Float @default(0)
  nota  String?

  creado  DateTime  @default(now())
  tocado  DateTime  @updatedAt
  acabado DateTime?

  puntos PuntoRejilla[]

  @@index([clienteId, creado])
}

/// Qué puesto tenía el negocio en un punto concreto del mapa.
model PuntoRejilla {
  id        String  @id @default(cuid())
  rejilla   Rejilla @relation(fields: [rejillaId], references: [id], onDelete: Cascade)
  rejillaId String

  fila    Int
  columna Int

  lat Float
  lng Float

  /// Nulo cuando el negocio no aparece entre los resultados de ese punto. Es
  /// un dato distinto de «puesto 20», y por eso no se guarda como un número
  /// grande: no aparecer no es ir último, es no estar.
  puesto Int?

  /// Cuántos resultados devolvió Google en ese punto.
  ///
  /// Existe porque cero resultados y «no apareces» son cosas distintas que se
  /// veían iguales en el mapa: un punto sin datos pintado de rojo dice que el
  /// negocio no sale ahí, y lo que pasó es que nadie preguntó bien. Con este
  /// número se pintan en gris y se quedan fuera de los porcentajes.
  resultados Int @default(0)

  /// Quién sale primero ahí cuando no somos nosotros. Es la mitad útil del
  /// dato: saber que no apareces no dice nada; saber quién ocupa tu sitio, sí.
  primero String?

  @@index([rejillaId])
}

/// Cuántas consultas tuvo un sitio en cada tramo de posición, un mes concreto.
///
/// Sale de Search Console, una llamada por mes. Se guarda porque un mes cerrado
/// ya no cambia: pedirlo otra vez cada vez que alguien abre el panorama serían
/// doce llamadas a Google para dibujar la misma línea de siempre.
///
/// El mes en curso sí se vuelve a pedir, porque le siguen entrando datos.
model TramoMes {
  id        String @id @default(cuid())
  clienteId String

  /// «2026-09».
  mes String

  top3  Int @default(0)
  top10 Int @default(0)
  top20 Int @default(0)
  top50 Int @default(0)
  resto Int @default(0)

  /// El total, para no tener que sumar los cinco al pintarlo.
  consultas Int @default(0)

  calculado DateTime @default(now())

  @@unique([clienteId, mes])
  @@index([clienteId, mes])
}

/// La última medición de velocidad de una URL.
///
/// Se guarda para que la pestaña Técnico pueda enseñar una nota sin volver a
/// medir: cada medición tarda medio minuto porque Google carga la página en un
/// navegador de verdad, y abrir una pestaña no puede costar eso.
///
/// Una fila por URL, sobrescrita: interesa la foto de ahora, no el histórico.
/// Si algún día hace falta la evolución, se quita el índice único.
model MedicionVelocidad {
  id        String @id @default(cuid())
  clienteId String
  url       String

  nota Int?
  lcp  Float?
  cls  Float?
  inp  Int?
  ttfb Int?

  /// Si los números vienen de usuarios reales o de una simulación.
  reales Boolean @default(false)

  medido DateTime @default(now())

  @@unique([clienteId, url])
  @@index([clienteId, medido])
}

/// Una URL tal como respondió durante un rastreo.
model Pagina {
  id        String  @id @default(cuid())
  rastreo   Rastreo @relation(fields: [rastreoId], references: [id], onDelete: Cascade)
  rastreoId String

  url String

  /// Código HTTP. Nulo cuando ni siquiera se pudo conectar.
  estado Int?
  /// Milisegundos hasta tener la página entera, no solo las cabeceras.
  ms     Int?

  /// A dónde acabó, si hubo redirección. Vacío si no la hubo.
  destino String?

  titulo      String?
  descripcion String?
  h1          String?
  canonical   String?

  /// Si el sitio pide a Google que NO la indexe. Es el fallo más caro de los
  /// silenciosos: la página existe, se ve bien, y no sale en Google jamás.
  noindex Boolean @default(false)

  /// Cuántos H1 tiene. Más de uno confunde sobre de qué va la página; ninguno
  /// deja a Google adivinando.
  h1s Int @default(0)

  palabras        Int @default(0)
  enlacesInternos Int @default(0)
  enlacesExternos Int @default(0)
  imagenesSinAlt  Int @default(0)

  /// Cuántos enlaces internos la apuntan a ella. Se rellena al terminar el
  /// rastreo, cuando ya se conoce el grafo entero: hasta entonces no se puede
  /// saber, porque quien la enlaza puede ser una página que aún no se ha visto.
  entrantes Int @default(0)

  /// A cuántos clics de la portada está, siguiendo enlaces. Nulo si no se llega
  /// a ella por ningún camino. Google reparte menos autoridad a lo que está
  /// hondo, y por encima de tres o cuatro clics una página deja de importar.
  profundidad Int?

  /// Los tipos de datos estructurados que declara, en JSON: ["Product",
  /// "BreadcrumbList"]. Vacío cuando no declara ninguno.
  tipos String @default("[]")

  /// Tiene JSON-LD pero no se puede leer. Es peor que no tenerlo: el sitio
  /// cree que se lo está contando a Google y Google lo descarta entero.
  ldRoto Boolean @default(false)

  /// Lo mínimo que debe declarar un HTML moderno.
  lang     String?
  viewport Boolean @default(false)
  charset  Boolean @default(false)

  /// Qué falló, cuando falló.
  error String?

  @@index([rastreoId, estado])
  @@index([rastreoId, url])
  @@index([rastreoId, titulo])
}

/// Un enlace interno de una página a otra, dentro de un rastreo.
///
/// Se guarda el grafo entero y no solo los contadores porque las dos preguntas
/// que de verdad importan necesitan saber quién apunta a quién: qué páginas no
/// recibe nadie —las huérfanas de verdad— y qué enlaces llevan a un 404.
///
/// Son muchas filas, del orden de cincuenta por página, pero se borran con su
/// rastreo y viven en la misma tabla que se consulta una vez.
model Enlace {
  id        String @id @default(cuid())
  rastreoId String

  desde String
  hacia String

  @@index([rastreoId, hacia])
  @@index([rastreoId, desde])
}



/// Una comprobación del vigía sobre un sitio.
///
/// Se guarda el histórico y no solo la última, porque «está caído» y «se cae
/// tres veces al día desde el martes» son dos problemas distintos y el segundo
/// no se ve sin las anteriores.
///
/// Mide dos cosas que fallan por separado: la portada pública, que es lo que
/// ve el cliente, y el conector, que es lo que necesita el panel. Un sitio
/// puede tener la web perfecta y el conector muerto, y conviene distinguirlo.
model Revision {
  id     String   @id @default(cuid())
  creado DateTime @default(now())

  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  /// Resultado de la portada pública.
  webOk     Boolean
  webEstado Int?
  /// Milisegundos que tardó en contestar. Sirve para ver una web que se está
  /// degradando antes de que se caiga del todo.
  webMs     Int?

  /// Resultado del conector. Nulo en Shopify, que no lleva conector.
  conectorOk Boolean?

  /// Qué falló, en una frase. Vacío cuando todo fue bien.
  detalle String?

  @@index([clienteId, creado])
  @@index([creado])
}

/// Qué usuario puede trabajar sobre qué cliente.
///
/// Existe como tabla propia y no como una lista en el usuario porque un
/// trabajador rara vez debe ver toda la cartera: se le asignan sus clientes.
model Acceso {
  id        String  @id @default(cuid())
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  @@unique([usuarioId, clienteId])
}

/// Qué se hizo, sobre qué cliente y quién lo hizo.
///
/// El plugin ya lleva su propio registro dentro de cada WordPress. Este es el
/// del panel, y responde a otra pregunta: no «qué le pasó al sitio» sino
/// «quién de mi equipo lo hizo».
model Registro {
  id        String   @id @default(cuid())
  creado    DateTime @default(now())
  accion    String
  resumen   String
  resultado String   @default("ok")

  /// Lo largo que no cabe en el resumen: el estado anterior de lo que el
  /// asistente escribió, para poder verlo y, algún día, restaurarlo.
  detalle String?

  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId String?

  @@index([clienteId, creado])
}

/// Tanda de trabajo sobre muchos elementos.
///
/// Se guarda en la base y no en memoria porque una tanda de 2000 productos
/// dura más que cualquier petición HTTP y tiene que sobrevivir a un reinicio.
model Trabajo {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  tipo     String // metadesc | descripcion | categoria
  estado   EstadoTrabajo @default(PENDIENTE)
  total    Int           @default(0)
  hechos   Int           @default(0)
  fallidos Int           @default(0)

  creado    DateTime  @default(now())
  iniciado  DateTime?
  terminado DateTime?
  error     String?

  items ItemTrabajo[]

  @@index([clienteId, estado])
}

enum EstadoTrabajo {
  PENDIENTE
  GENERANDO
  LISTO_PARA_REVISAR
  ESCRIBIENDO
  TERMINADO
  FALLIDO
  CANCELADO
}

/// Un elemento dentro de una tanda: un producto, una categoría, una página.
model ItemTrabajo {
  id        String  @id @default(cuid())
  trabajo   Trabajo @relation(fields: [trabajoId], references: [id], onDelete: Cascade)
  trabajoId String

  objetoId Int
  nombre   String

  /// Huella del contenido original al leerlo. Si al escribir no coincide,
  /// alguien lo editó por su cuenta y el item se salta en vez de pisarlo.
  huella String?

  propuesto String?
  anterior  String?
  estado    String  @default("pendiente")
  error     String?

  @@unique([trabajoId, objetoId])
  @@index([trabajoId, estado])
}

/// Conversación del panel sobre un cliente concreto.
/// Un hilo de trabajo sobre un cliente.
///
/// Es del CLIENTE, no de quien lo abrió: cualquiera con acceso a esa ficha lo
/// ve y puede seguirlo. Al principio eran privados por persona y resultó ser
/// justo lo contrario de lo que hace falta — si un colaborador le pide algo a
/// la IA sobre un sitio, el resto del equipo necesita saber qué se pidió y qué
/// se hizo, o dos personas acaban rehaciendo el mismo trabajo.
///
/// `usuarioId` se conserva: es quien abrió el hilo, y se enseña.
model Conversacion {
  id        String   @id @default(cuid())
  clienteId String
  usuarioId String
  titulo    String   @default("Nueva conversación")
  creado    DateTime @default(now())
  tocado    DateTime @updatedAt

  mensajes Mensaje[]

  @@index([clienteId, tocado])
}

/// Un turno de la conversación.
model Mensaje {
  id             String       @id @default(cuid())
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  conversacionId String

  rol       String // user | assistant
  contenido String

  /// Quién lo escribió, en los turnos de persona. Nulo en los del asistente y
  /// en los hilos de antes de compartirlos. Hace falta porque en un hilo
  /// compartido pueden escribir varios y «quién dijo esto» deja de ser obvio.
  usuarioId String?
  /// Imágenes adjuntas, como JSON de data URIs. Se guardan para que el hilo
  /// se vea completo al recargarlo, pero al hablar con el modelo solo viajan
  /// las de los últimos turnos: reenviar todas en cada mensaje multiplicaría
  /// el coste de una conversación larga.
  imagenes  String?
  /// Herramientas usadas en este turno, en JSON. Sirve para mostrar en la
  /// interfaz qué tocó el asistente, no solo lo que dijo.
  usadas    String?
  entrada   Int      @default(0)
  salida    Int      @default(0)
  creado    DateTime @default(now())

  @@index([conversacionId, creado])
}

/// Ajustes del panel que se cambian desde la interfaz.
///
/// Existe como tabla de clave y valor, y no como columnas, porque son cuatro
/// ajustes sueltos que van a crecer: una tabla por cada uno sería ceremonia
/// sin beneficio. Los valores sensibles se guardan cifrados, igual que los
/// secretos de los clientes.
model Config {
  clave   String   @id
  valor   String
  cifrado Boolean  @default(false)
  tocado  DateTime @updatedAt
}

/// Arquitectura SEO transaccional de un cliente, leída de su Excel AST.
model Arquitectura {
  /// La hoja del Excel ya leída, en JSON. Se guarda para poder rehacer la
  /// lectura con un esquema corregido sin pedir el archivo otra vez, que es
  /// lo que permite arreglar una arquitectura mal interpretada hablando.
  rejilla String?
  esquema String?

  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  nombre    String
  archivo   String
  subidoPor String?
  creado    DateTime  @default(now())
  cotejado  DateTime?

  nodos NodoArquitectura[]

  @@index([clienteId, creado])
}

/// Una sección de la arquitectura: una categoría, subcategoría o página
/// prevista, con las keywords que debería atacar.
model NodoArquitectura {
  id             String       @id @default(cuid())
  arquitectura   Arquitectura @relation(fields: [arquitecturaId], references: [id], onDelete: Cascade)
  arquitecturaId String

  slug    String
  nombre  String
  nivel   Int
  orden   Int     @default(0)
  padreId String?

  /// Keywords objetivo en JSON, con su volumen.
  keywords String @default("[]")
  volumen  Int    @default(0)

  // --- Resultado del cotejo contra el sitio ---
  //
  // `dudosa` existe a propósito: forzar cada sección a creada o falta
  // convertiría en «falta» cosas que existen con otro nombre, y en «creada»
  // coincidencias que no lo son. Lo dudoso se revisa, no se adivina.
  estado       String  @default("pendiente") // pendiente | creada | dudosa | falta
  urlDestino   String?
  objetoId     Int?
  tipoObjeto   String?
  confianza    Int?
  nota         String?
  comoSeCotejo String? // slug | nombre | ia

  @@index([arquitecturaId, estado])
  @@index([arquitecturaId, orden])
}

/// Consulta cuya posición se vigila para un cliente.
model Keyword {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  termino String

  /// Código de ubicación de Google Ads. 2152 es Chile.
  ubicacion Int    @default(2152)
  idioma    String @default("es")

  /// «desktop» o «mobile»: la misma consulta da resultados distintos, y en
  /// ecommerce el móvil suele ser el que importa.
  dispositivo String @default("desktop")

  /// URL que se espera que posicione. Sirve para avisar cuando Google elige
  /// otra página del sitio, que es un problema de canibalización y no de
  /// posición.
  urlObjetivo String?

  activa Boolean  @default(true)
  creado DateTime @default(now())

  posiciones Posicion[]

  @@unique([clienteId, termino, ubicacion, dispositivo])
  @@index([clienteId, activa])
}

/// Una medición concreta. Se guarda el histórico entero: el valor de esto no
/// es la posición de hoy, es la curva.
model Posicion {
  id        String  @id @default(cuid())
  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  /// null cuando el sitio no aparece en los cien primeros resultados.
  puesto Int?

  /// La URL concreta que Google eligió mostrar.
  url String?

  /// Resultados totales y cuántos bloques no orgánicos había por encima:
  /// estar tercero bajo un bloque de anuncios y un mapa no es estar tercero.
  bloquesArriba Int?

  medido DateTime @default(now())

  /// Lo que costó la consulta, tal como lo informa el proveedor.
  coste Float?

  @@index([keywordId, medido])
}

/// Cuenta de Google autorizada para leer Search Console.
///
/// Se guarda el token de refresco y no el de acceso: el de acceso dura una
/// hora, el de refresco no caduca mientras el usuario no revoque el permiso
/// desde su cuenta de Google. Va cifrado porque da acceso de lectura a los
/// datos de búsqueda de todos los sitios de esa persona.
model ConexionGoogle {
  id     String @id @default(cuid())
  correo String @unique

  /// Token de refresco cifrado con AES-256-GCM.
  refresco String

  creado   DateTime @default(now())
  usadoPor String?

  clientes Cliente[]
}

/// Cómo está montado un tipo de Excel de arquitectura.
///
/// Lo caro y lo frágil de leer estos archivos no son los datos, es entender la
/// plantilla: qué columna es cada nivel, cómo se distingue el nombre de una
/// sección de sus keywords. Eso lo deduce el modelo una vez y se guarda aquí;
/// a partir de entonces el mismo formato se lee sin volver a preguntarle, y
/// los formatos ya conocidos se le enseñan como ejemplo cuando llega uno nuevo.
model PlantillaAst {
  id     String @id @default(cuid())
  nombre String

  /// Huella de la cabecera, para reconocer un archivo del mismo formato.
  huella String @unique

  /// El esquema en JSON: hoja, columnas por nivel, y cómo se marca una sección.
  esquema String

  /// Muestra de filas que originó el esquema, para enseñárselo al modelo.
  muestra String?

  usos     Int      @default(0)
  acertado Boolean  @default(true)
  creado   DateTime @default(now())
}

/// Lo que el asistente ha aprendido de un sitio concreto.
///
/// Va atado al cliente y solo se lee con su identificador en el where: la
/// gracia es que acumule conocimiento profundo de cada dominio, y mezclar lo
/// de uno con lo de otro sería peor que no recordar nada —le haría afirmar
/// sobre un sitio cosas que son ciertas en otro.
///
/// El título hace de clave: una nota sobre el mismo asunto se reemplaza en vez
/// de duplicarse, para que la memoria no crezca sin control ni se contradiga.
model Memoria {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  titulo String
  nota   String

  creado DateTime @default(now())
  tocado DateTime @updatedAt

  @@unique([clienteId, titulo])
  @@index([clienteId])
}

/// Cada operación que cuesta dinero, anotada al ocurrir.
///
/// Se guarda el importe ya calculado y no solo los tokens: las tarifas
/// cambian, y recalcular el pasado con la tarifa de hoy daría una cifra que
/// nunca se pagó. Lo que se cobró se cobró.
model Gasto {
  id        String   @id @default(cuid())
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuarioId String?

  /// «claude» o «dataforseo». Es lo que separa las dos facturas.
  servicio String

  /// Qué se estaba haciendo: chat, posiciones, serp, arquitectura.
  concepto String

  /// En dólares.
  monto Float

  /// Para poder auditarlo: tokens, número de consultas, modelo usado.
  detalle String?

  creado DateTime @default(now())

  @@index([clienteId, creado])
  @@index([creado])
}

/// Qué se hizo por un cliente, mes a mes, contado para el cliente.
///
/// No es el registro técnico —ese ya existe y está lleno de nombres de
/// herramienta que a nadie le dicen nada—. Esto es lo que se le enseña a quien
/// paga: frases enteras, sin jerga, agrupadas por mes.
model Bitacora {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// «2026-09». Se guarda como texto porque se agrupa y se ordena por él, y
  /// una fecha real invitaría a preguntarle el día, que aquí no significa nada.
  mes String

  /// contenido · tecnico · arquitectura · diseno · analisis · otro
  categoria String @default("otro")

  /// La línea que lee el cliente. Una frase, sin punto final.
  titulo String

  /// Detalle opcional, para cuando hace falta explicarlo.
  detalle String?

  /// URLs afectadas, en JSON. Sirven de prueba de lo hecho.
  urls String?

  /// Si lo anotó el asistente al trabajar, o lo escribió una persona.
  automatico Boolean @default(false)

  creado DateTime @default(now())

  @@index([clienteId, mes])
}

/// Última foto del perfil de enlaces de un sitio.
///
/// Se guarda entera en vez de consultarse al abrir la pestaña porque cada
/// consulta al proveedor cuesta dinero y los backlinks no cambian de una hora
/// a otra. Mirar sale gratis; actualizar se pide a propósito.
model Backlinks {
  id        String  @id @default(cuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// La instantánea completa, en JSON.
  datos String

  coste  Float?
  medido DateTime @default(now())
}

/// Una consulta de exploración sobre un dominio cualquiera.
///
/// No cuelga de Cliente a propósito: sirve sobre todo para dominios que aún no
/// lo son —un cliente potencial, su competencia— y atarla a la ficha habría
/// impedido justo el uso más valioso.
model Exploracion {
  id      String @id @default(cuid())
  dominio String
  pais    Int    @default(2152)

  /// La instantánea completa, en JSON.
  datos String

  coste     Float?
  usuarioId String?
  creado    DateTime @default(now())

  @@unique([dominio, pais])
  @@index([creado])
}

/// El almacén de palabras clave de la agencia.
///
/// Se llena solo: cada investigación de una semilla y cada exploración de un
/// dominio vuelca aquí lo que trajo. La diferencia con Investigacion y
/// Exploracion —que guardan el JSON entero— es que aquí sí se puede preguntar:
/// «todas las de más de 300 búsquedas», «¿ya había visto esta?», «¿en cuántos
/// competidores aparece?».
///
/// Es lo único de este panel que se vuelve más valioso solo por usarlo.
model Termino {
  id      String @id @default(cuid())
  keyword String
  pais    Int    @default(2152)

  volumen     Int     @default(0)
  cpc         Float?
  competencia Float?
  /// «informational», «commercial», «transactional» o «navigational».
  intencion   String?
  /// Variación del volumen contra el mismo mes del año pasado, en porcentaje.
  tendencia   Int?
  palabras    Int     @default(1)

  /// De dónde salió, en JSON: semillas y dominios. Una palabra que aparece en
  /// cinco competidores dice algo que su volumen no dice.
  origenes String @default("[]")

  /// Cuántas veces la hemos vuelto a encontrar.
  veces Int @default(1)

  /// Cuándo se vio por primera vez y cuándo se refrescó el dato.
  ///
  /// Las dos fechas importan y son distintas: la primera dice desde cuándo la
  /// conocemos, la segunda si el volumen que enseñamos sigue valiendo. Sin la
  /// segunda alguien decidiría con una cifra de hace ocho meses creyéndola de
  /// hoy.
  creado      DateTime @default(now())
  actualizado DateTime @default(now())

  @@unique([keyword, pais])
  @@index([pais, volumen])
  @@index([actualizado])
}

/// Una investigación de palabras clave ya pagada.
///
/// Mismo trato que las exploraciones de dominio: se guarda entera para que
/// volver a mirarla sea gratis. Buscar dos veces «regalos corporativos» en la
/// misma semana no debería costar dos veces, y sin caché acabaría costando
/// cada vez que alguien recarga la página.
model Investigacion {
  id      String @id @default(cuid())
  semilla String
  pais    Int    @default(2152)

  /// Las sugerencias completas, en JSON.
  datos String

  /// Cuántas trajo, para poder ordenar el historial sin abrir el JSON.
  cuantas Int @default(0)

  coste     Float?
  usuarioId String?
  creado    DateTime @default(now())

  @@unique([semilla, pais])
  @@index([creado])
}

/// Hasta dónde se contó ya el registro de un mes en la bitácora.
///
/// Sin esta marca, actualizar significa releer el mes entero y volver a
/// decidir qué es nuevo, que es justo donde el modelo se equivoca: o repite lo
/// ya contado o concluye que no hay nada. Con la marca, «actualizar» solo mira
/// lo ocurrido después.
model CorteBitacora {
  id        String   @id @default(cuid())
  clienteId String
  mes       String
  hasta     DateTime
  tocado    DateTime @updatedAt

  @@unique([clienteId, mes])
}
