// Esquema del panel AppSEO.
//
// En producción corre sobre Postgres. Para volver a SQLite en local basta con
// cambiar `provider`, pero las migraciones no son intercambiables entre ambos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Persona que entra al panel.
model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  nombre       String
  clave        String // hash bcrypt, nunca la contraseña
  rol          Rol       @default(EDITOR)
  activo       Boolean   @default(true)
  creado       DateTime  @default(now())
  ultimoAcceso DateTime?

  accesos  Acceso[]
  registro Registro[]
}

enum Rol {
  ADMIN // todo, incluida la gestión de usuarios
  GESTOR // toda la cartera y todas las operaciones, salvo gestionar usuarios
  EDITOR // trabaja sobre los clientes que tenga asignados
  LECTOR // solo consulta
}

/// Sitio WordPress conectado mediante el plugin AppSEO RyF.
model Cliente {
  id      String @id @default(cuid())
  nombre  String
  dominio String @unique
  urlRest String
  keyId   String

  /// Secreto HMAC cifrado con AES-256-GCM. Nunca se guarda en claro.
  secreto String

  activo Boolean  @default(true)
  creado DateTime @default(now())

  // Última foto conocida, para no consultar el sitio en cada carga.
  version     String?
  soloLectura Boolean?
  ultimaSonda DateTime?
  estadoSonda String?

  /// Función en pruebas: no todos los proyectos la necesitan, así que se
  /// activa cliente a cliente en vez de aparecerle a todo el mundo.
  betaArquitectura Boolean @default(false)

  accesos       Acceso[]
  registro      Registro[]
  trabajos      Trabajo[]
  arquitecturas Arquitectura[]
  keywords      Keyword[]
}

/// Qué usuario puede trabajar sobre qué cliente.
///
/// Existe como tabla propia y no como una lista en el usuario porque un
/// trabajador rara vez debe ver toda la cartera: se le asignan sus clientes.
model Acceso {
  id        String  @id @default(cuid())
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  @@unique([usuarioId, clienteId])
}

/// Qué se hizo, sobre qué cliente y quién lo hizo.
///
/// El plugin ya lleva su propio registro dentro de cada WordPress. Este es el
/// del panel, y responde a otra pregunta: no «qué le pasó al sitio» sino
/// «quién de mi equipo lo hizo».
model Registro {
  id        String   @id @default(cuid())
  creado    DateTime @default(now())
  accion    String
  resumen   String
  resultado String   @default("ok")

  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId String?

  @@index([clienteId, creado])
}

/// Tanda de trabajo sobre muchos elementos.
///
/// Se guarda en la base y no en memoria porque una tanda de 2000 productos
/// dura más que cualquier petición HTTP y tiene que sobrevivir a un reinicio.
model Trabajo {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  tipo     String // metadesc | descripcion | categoria
  estado   EstadoTrabajo @default(PENDIENTE)
  total    Int           @default(0)
  hechos   Int           @default(0)
  fallidos Int           @default(0)

  creado    DateTime  @default(now())
  iniciado  DateTime?
  terminado DateTime?
  error     String?

  items ItemTrabajo[]

  @@index([clienteId, estado])
}

enum EstadoTrabajo {
  PENDIENTE
  GENERANDO
  LISTO_PARA_REVISAR
  ESCRIBIENDO
  TERMINADO
  FALLIDO
  CANCELADO
}

/// Un elemento dentro de una tanda: un producto, una categoría, una página.
model ItemTrabajo {
  id        String  @id @default(cuid())
  trabajo   Trabajo @relation(fields: [trabajoId], references: [id], onDelete: Cascade)
  trabajoId String

  objetoId Int
  nombre   String

  /// Huella del contenido original al leerlo. Si al escribir no coincide,
  /// alguien lo editó por su cuenta y el item se salta en vez de pisarlo.
  huella String?

  propuesto String?
  anterior  String?
  estado    String  @default("pendiente")
  error     String?

  @@unique([trabajoId, objetoId])
  @@index([trabajoId, estado])
}

/// Conversación del panel sobre un cliente concreto.
model Conversacion {
  id        String   @id @default(cuid())
  clienteId String
  usuarioId String
  titulo    String   @default("Nueva conversación")
  creado    DateTime @default(now())
  tocado    DateTime @updatedAt

  mensajes Mensaje[]

  @@index([clienteId, tocado])
}

/// Un turno de la conversación.
model Mensaje {
  id             String       @id @default(cuid())
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  conversacionId String

  rol       String // user | assistant
  contenido String
  /// Imágenes adjuntas, como JSON de data URIs. Se guardan para que el hilo
  /// se vea completo al recargarlo, pero al hablar con el modelo solo viajan
  /// las de los últimos turnos: reenviar todas en cada mensaje multiplicaría
  /// el coste de una conversación larga.
  imagenes  String?
  /// Herramientas usadas en este turno, en JSON. Sirve para mostrar en la
  /// interfaz qué tocó el asistente, no solo lo que dijo.
  usadas    String?
  entrada   Int      @default(0)
  salida    Int      @default(0)
  creado    DateTime @default(now())

  @@index([conversacionId, creado])
}

/// Ajustes del panel que se cambian desde la interfaz.
///
/// Existe como tabla de clave y valor, y no como columnas, porque son cuatro
/// ajustes sueltos que van a crecer: una tabla por cada uno sería ceremonia
/// sin beneficio. Los valores sensibles se guardan cifrados, igual que los
/// secretos de los clientes.
model Config {
  clave   String   @id
  valor   String
  cifrado Boolean  @default(false)
  tocado  DateTime @updatedAt
}

/// Arquitectura SEO transaccional de un cliente, leída de su Excel AST.
model Arquitectura {
  id        String  @id @default(cuid())
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  nombre    String
  archivo   String
  subidoPor String?
  creado    DateTime  @default(now())
  cotejado  DateTime?

  nodos NodoArquitectura[]

  @@index([clienteId, creado])
}

/// Una sección de la arquitectura: una categoría, subcategoría o página
/// prevista, con las keywords que debería atacar.
model NodoArquitectura {
  id             String       @id @default(cuid())
  arquitectura   Arquitectura @relation(fields: [arquitecturaId], references: [id], onDelete: Cascade)
  arquitecturaId String

  slug    String
  nombre  String
  nivel   Int
  orden   Int     @default(0)
  padreId String?

  /// Keywords objetivo en JSON, con su volumen.
  keywords String @default("[]")
  volumen  Int    @default(0)

  // --- Resultado del cotejo contra el sitio ---
  //
  // `dudosa` existe a propósito: forzar cada sección a creada o falta
  // convertiría en «falta» cosas que existen con otro nombre, y en «creada»
  // coincidencias que no lo son. Lo dudoso se revisa, no se adivina.
  estado       String  @default("pendiente") // pendiente | creada | dudosa | falta
  urlDestino   String?
  objetoId     Int?
  tipoObjeto   String?
  confianza    Int?
  nota         String?
  comoSeCotejo String? // slug | nombre | ia

  @@index([arquitecturaId, estado])
  @@index([arquitecturaId, orden])
}

/// Consulta cuya posición se vigila para un cliente.
model Keyword {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  termino String

  /// Código de ubicación de Google Ads. 2152 es Chile.
  ubicacion Int    @default(2152)
  idioma    String @default("es")

  /// «desktop» o «mobile»: la misma consulta da resultados distintos, y en
  /// ecommerce el móvil suele ser el que importa.
  dispositivo String @default("desktop")

  /// URL que se espera que posicione. Sirve para avisar cuando Google elige
  /// otra página del sitio, que es un problema de canibalización y no de
  /// posición.
  urlObjetivo String?

  activa Boolean  @default(true)
  creado DateTime @default(now())

  posiciones Posicion[]

  @@unique([clienteId, termino, ubicacion, dispositivo])
  @@index([clienteId, activa])
}

/// Una medición concreta. Se guarda el histórico entero: el valor de esto no
/// es la posición de hoy, es la curva.
model Posicion {
  id        String  @id @default(cuid())
  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  /// null cuando el sitio no aparece en los cien primeros resultados.
  puesto Int?

  /// La URL concreta que Google eligió mostrar.
  url String?

  /// Resultados totales y cuántos bloques no orgánicos había por encima:
  /// estar tercero bajo un bloque de anuncios y un mapa no es estar tercero.
  bloquesArriba Int?

  medido DateTime @default(now())

  /// Lo que costó la consulta, tal como lo informa el proveedor.
  coste Float?

  @@index([keywordId, medido])
}
